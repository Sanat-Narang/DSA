#include <stdio.h>

int main() {
    int n, d;
    scanf("%d", &n);

    while (n) {
        d = n % 10;

        if (d == 0) printf("000");
        else if (d == 1) printf("001");
        else if (d == 2) printf("010");
        else if (d == 3) printf("011");
        else if (d == 4) printf("100");
        else if (d == 5) printf("101");
        else if (d == 6) printf("110");
        else if (d == 7) printf("111");

        n /= 10;
    }
    return 0;

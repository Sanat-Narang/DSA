#include<stdio.h>
#define MAX 100

int list[MAX], n = 0;

void insertBeg(int val){
    for(int i=n-1;i>=0;i--) list[i+1]=list[i];
    list[0]=val;
    n++;
}

void insertEnd(int val){
    list[n++]=val;
}

void insertPos(int pos,int val){
    if(pos<0 || pos>n) return;
    for(int i=n-1;i>=pos;i--) list[i+1]=list[i];
    list[pos]=val;
    n++;
}

void deleteBeg(){
    for(int i=0;i<n-1;i++) list[i]=list[i+1];
    n--;
}

void deleteEnd(){
    n--;
}

void deletePos(int pos){
    if(pos<0 || pos>=n) return;
    for(int i=pos;i<n-1;i++) list[i]=list[i+1];
    n--;
}

void display(){
    for(int i=0;i<n;i++) printf("%d ",list[i]);
    printf("\n");
}

void search(int key){
    for(int i=0;i<n;i++)
        if(list[i]==key){
            printf("Found at %d\n",i);
            return;
        }
    printf("Not found\n");
}

void update(int pos,int val){
    if(pos>=0 && pos<n) list[pos]=val;
}

void sort(){
    for(int i=0;i<n-1;i++)
        for(int j=i+1;j<n;j++)
            if(list[i]>list[j]){
                int t=list[i];
                list[i]=list[j];
                list[j]=t;
            }
}
